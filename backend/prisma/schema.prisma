datasource db {
provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model Resource {
  id Int @id @default(autoincrement())
  title String
  description String
  logo String?
  type Type @default(Tool)
  url String
  createdAt DateTime @default(now())
  tags Tag[]
  category Category @relation(fields: [categoryId], references: [id])
  categoryId Int
}

model Category {
  id Int @id @default(autoincrement())
  name String
  resources Resource[]
}

model Tag{
  id Int @id @default(autoincrement())
  name String
  resources Resource[]
}

enum Type {
  Tool
  Docs
}