datasource db {
provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model Resource {
  id Int @id @default(autoincrement())
  title String
  description String
  logo String?
  type Type @default(Tools)
  url String
  createdAt DateTime @default(now())
  status Status? @relation(fields: [statusId], references: [id])
  statusId Int?
  categories Category[]
}

model Category {
  id Int @id @default(autoincrement())
  name String
  resources Resource[]
}

model Status {
  id Int @id @default(autoincrement())
  name String
  resources Resource[]
}

enum Type {
  Tools
  References
  Libraries
  Inspiration
  Services
  Extensions
  Social
}